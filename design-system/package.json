      "types": "./src/components/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
